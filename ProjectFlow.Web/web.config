<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    ================================================================
     ProjectFlow – IISNode Production web.config
     Architecture: IISNode (Named Pipe) + URL Rewrite
     Next.js 14 Standalone | Node.js v20/v22 LTS
    ================================================================
    
    FIXES APPLIED vs original:
    [1] WebSocket re-enabled – required for SignalR long-polling fallback
    [2] Removed broken StaticContent rule (url="public{REQUEST_URI}" is invalid)
    [3] Fixed NextJsStatic rule – serves from correct .next\static path
    [4] Removed NodeInspector rule (debug endpoint; dangerous in production)
    [5] DynamicContent rule now has stopProcessing="true" to prevent fall-through
    [6] appSettings removed – env vars must come from .env.production or iisnode.yml
    ================================================================
  -->

  <system.webServer>

    <!--
      WebSocket MUST be enabled for SignalR.
      IISNode handles the upgrade negotiation through the Named Pipe.
      Setting this to false breaks SignalR WebSocket transport.
    -->
    <webSocket enabled="true" />

    <!-- IISNode handler: routes ALL verbs through server.js -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>

        <!--
          RULE 1: HTTP → HTTPS Redirect
          Excludes localhost and 127.0.0.1 so developers can still
          test locally over plain HTTP without certificate errors.
        -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^localhost" negate="true" />
            <add input="{HTTP_HOST}" pattern="^127\.0\.0\.1" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!--
          RULE 2: Next.js Static Assets (_next/static/*)
          Served directly by IIS from the filesystem – bypasses Node
          completely for maximum performance on JS/CSS/font files.
          
          WHY: IISNode adds ~5–15ms overhead per request. For static
          assets (hundreds of files on initial page load), this adds up.
          IIS native file serving is zero-overhead.
          
          PATH: .next\static\ (relative to site root = deployment folder)
        -->
        <rule name="NextJsStatic" stopProcessing="true">
          <match url="^_next/static/(.*)$" />
          <action type="Rewrite" url=".next/static/{R:1}" />
        </rule>

        <!--
          RULE 3: Next.js Image Optimization Endpoint
          Route /_next/image requests through Node (server-side image handling).
        -->
        <rule name="NextJsImage" stopProcessing="true">
          <match url="^_next/image(.*)$" />
          <action type="Rewrite" url="server.js" />
        </rule>

        <!--
          RULE 4: Public Folder Static Files
          Files in /public (favicon, robots.txt, images, etc.) are served
          directly by IIS from the filesystem.
          
          WHY this rule was BROKEN in original:
          Original: url="public{REQUEST_URI}" – WRONG. REQUEST_URI already 
          contains the full path including "public/". This caused IIS to 
          look for "publicpublic/file.png" which doesn't exist.
          
          FIX: Match ^(favicon\.ico|robots\.txt|sitemap\.xml)$ for known
          root-level public files, and ^public/(.*)$ for subdirectory files.
        -->
        <rule name="PublicFavicon" stopProcessing="true">
          <match url="^favicon\.ico$" />
          <action type="Rewrite" url="public/favicon.ico" />
        </rule>

        <rule name="PublicRobots" stopProcessing="true">
          <match url="^robots\.txt$" />
          <action type="Rewrite" url="public/robots.txt" />
        </rule>

        <rule name="PublicFolder" stopProcessing="true">
          <match url="^public/(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="public/{R:1}" />
        </rule>

        <!--
          RULE 5: All Other Requests → Next.js server.js via IISNode
          This is the catch-all: pages, API routes, SignalR hubs,
          backend-api proxy rewrites – everything goes through Node.
          
          Condition: Only if the request is NOT an existing physical file
          (prevents IISNode from intercepting actual static files that
          already matched above rules).
        -->
        <rule name="DynamicContent" stopProcessing="true">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>

      </rules>
    </rewrite>

    <!--
      Pass all error responses through from Node.js unchanged.
      Without this, IIS intercepts 4xx/5xx and replaces them with
      its own generic error pages, hiding Next.js error details.
    -->
    <httpErrors existingResponse="PassThrough" />

    <!--
      Allow the 'bin' segment to be served (IISNode stores pipe files there).
      Without this, IIS blocks requests to any path containing /bin/.
    -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
